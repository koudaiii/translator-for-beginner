{
  "manifest_version": 3,
  "name": "選択範囲を日本語に翻訳",
  "version": "0.5.0",
  "description": "選択したテキストを Azure Translator で日本語に翻訳して表示する",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.cognitive.microsofttranslator.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "action.html", "default_title": "英文を日本語に翻訳" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "選択範囲を日本語に翻訳"
    }
  },
  "web_accessible_resources": [
    { "resources": ["popup.css"], "matches": ["<all_urls>"] }
  ]
}
